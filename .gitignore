node_modules/
dist/

# Bundled server (npm run bundle:server). A build artifact, regenerated on
# demand. Anchored: app/build holds committed icon resources.
/build/

# The learner's own state — progress, journal, profile, drafts, snapshots,
# run workspaces, logs. Leading slash matters: a bare "data/" would also
# ignore source directories like web/src/data.
/data/

# Large vendored runtimes, restored by scripts/copy-pyodide.mjs on install
web/public/pyodide/
web/public/sql-wasm*.wasm

*.log

# Secrets: ignore .env at ANY depth (that's where a stray key would land),
# but let lessons ship .env files as teaching material.
.env
.env.*
!content/**/.env
!content/**/.env.*

# Per-machine Claude Code config — the ".local" half is meant to stay local
.claude/settings.local.json
app/dist/
app/node_modules/

# Windows shortcut holds absolute paths; regenerated by npm run app:shortcut
*.lnk
