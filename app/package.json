{
  "name": "programming-teacher-app",
  "productName": "Programming Teacher",
  "version": "1.0.0",
  "private": true,
  "description": "Learn programming with an AI tutor",
  "author": "Bradley",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.bradley.programmingteacher",
    "productName": "Programming Teacher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs"
    ],
    "afterPack": "./afterPack.cjs",
    "extraResources": [
      {
        "from": "../content",
        "to": "content"
      },
      {
        "from": "../docs-content",
        "to": "docs-content"
      },
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName} ${version}.exe",
      "unpackDirName": "ProgrammingTeacher-1.0.0"
    }
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
